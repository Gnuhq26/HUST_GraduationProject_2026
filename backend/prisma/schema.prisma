generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "../../docs/thesis/diagrams/erd.png"
//   theme     = "neutral"
// }

datasource db {
  provider = "mysql"
  // Connection URL moved to prisma.config.ts; configure the connection for Migrate and PrismaClient there.
  // See https://pris.ly/d/config-datasource and https://pris.ly/d/prisma7-client-config
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

model Store {
  StoreID Int @id @default(autoincrement())
  StoreName String @db.VarChar(255)
  Subdomain String @unique @db.VarChar(100)
  DisplayId String? @unique @db.VarChar(20)
  SlugName String? @unique @db.VarChar(100)
  SlugNameExpiredAt DateTime? @db.Timestamp(0)
  Phone String? @db.VarChar(20)
  Address String? @db.VarChar(500)
  Status String @default("Active") @db.VarChar(50)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)

  // Relations
  roles Role[]
  storeUsers StoreUser[]
  categories Category[]
  products Product[]
  suppliers Supplier[]
  inventories Inventory[]
  customers Customer[]
  orders Order[]
  stockReceipts StockReceipt[]
}

model Role {
  RoleID Int @id @default(autoincrement())
  StoreID Int
  RoleName String @db.VarChar(100)
  Description String? @db.VarChar(255)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store Store @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  storeUsers StoreUser[]
  rolePermissions RolePermission[]

  @@unique([StoreID, RoleName])
}

model Permission {
  PermissionID Int @id @default(autoincrement())
  Action String @db.VarChar(100)
  Subject String @db.VarChar(100)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  rolePermissions RolePermission[]

  @@unique([Action, Subject])
}

model RolePermission {
  RoleID Int
  PermissionID Int
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  role Role @relation(fields: [RoleID], references: [RoleID], onDelete: Cascade)
  permission Permission @relation(fields: [PermissionID], references: [PermissionID], onDelete: Cascade)

  @@id([RoleID, PermissionID])
}

model User {
  UserID Int @id @default(autoincrement())
  Email String @unique @db.VarChar(255)
  PasswordHash String? @db.VarChar(255)
  FullName String? @db.VarChar(100)
  Phone String? @db.VarChar(20)
  Address String? @db.VarChar(255)
  Provider AuthProvider @default(LOCAL)
  ProviderID String? @db.VarChar(255)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)

  // Relations
  storeUsers StoreUser[]
  orders Order[]

  @@unique([Provider, ProviderID])
}

model StoreUser {
  StoreID Int
  UserID Int
  RoleID Int
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store Store @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  user User @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  role Role @relation(fields: [RoleID], references: [RoleID], onDelete: Restrict)

  @@id([StoreID, UserID])
}

// ==========================================
// PHẦN NGHIỆP VỤ (BUSINESS LOGIC)
// ==========================================

model Category {
  CategoryID   Int      @id @default(autoincrement())
  StoreID      Int
  CategoryName String   @db.VarChar(255)
  Description  String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt    DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store     @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  products     Product[]

  @@unique([StoreID, CategoryName]) // Tránh trùng tên danh mục trong cùng 1 cửa hàng
}

model Product {
  ProductID   Int      @id @default(autoincrement())
  StoreID     Int
  CategoryID  Int
  ProductName String   @db.VarChar(255)
  SKU         String?  @db.VarChar(50) 
  BaseUnit    String   @db.VarChar(50) // Đơn vị gốc (ví dụ: Viên, Kg, Bao)
  Description String?  @db.Text
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt   DateTime @updatedAt @db.Timestamp(0)

  MarginRate  Decimal  @db.Decimal(5, 2) @default(0.10) // Biên lợi nhuận mục tiêu (0.10 = 10%)

  // Relations
  store        Store         @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  category     Category      @relation(fields: [CategoryID], references: [CategoryID], onDelete: Restrict)
  units        ProductUnit[]
  inventories  Inventory[]
  stockReceiptDetails StockReceiptDetail[]
  orderDetails OrderDetail[]
  inventoryLogs InventoryLog[]

  @@unique([StoreID, SKU]) // Mã hàng không được trùng trong cùng 1 cửa hàng
}

model ProductUnit {
  UnitID        Int     @id @default(autoincrement())
  ProductID     Int
  UnitName      String  @db.VarChar(50) // Ví dụ: Pallet, Xe, Thùng
  ExchangeValue Decimal @db.Decimal(18, 3) // Tỷ lệ quy đổi (ví dụ: 1 Pallet = 500.000 Viên)
  IsDefault     Boolean @default(false)

  // Relations
  product       Product @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)
}

// ==========================================
// KHO HÀNG VÀ NHẬP XUẤT (INVENTORY MANAGEMENT)
// ==========================================

// 1. Quản lý Nhà cung cấp
model Supplier {
  SupplierID   Int      @id @default(autoincrement())
  StoreID      Int
  SupplierName String   @db.VarChar(255)
  Phone        String?  @db.VarChar(20)
  Address      String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt    DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  receipts     StockReceipt[]

  @@unique([StoreID, SupplierName]) // Tránh trùng tên nhà cung cấp trong cùng 1 cửa hàng
}

// 2. Bảng Tồn kho thực tế (Inventory)
model Inventory {
  InventoryID  Int      @id @default(autoincrement())
  StoreID      Int
  ProductID    Int
  Quantity     Decimal  @db.Decimal(18, 2) @default(0) // Luôn lưu theo đơn vị gốc (BaseUnit)
  ReservedQty  Decimal  @db.Decimal(18, 2) @default(0) // Số lượng đã đặt nhưng chưa xuất kho (xuất ảo)
  InTransitQty Decimal  @db.Decimal(18, 2) @default(0) // Số lượng đang trên đường về (tồn ảo)
  LastUpdated  DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  product      Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)

  @@unique([StoreID, ProductID]) // Mỗi sản phẩm trong một cửa hàng chỉ có 1 dòng tồn kho chính
}

// 3. Phiếu nhập kho
model StockReceipt {
  ReceiptID    Int      @id @default(autoincrement())
  ReceiptCode  String?  @unique @db.VarChar(30) // PN-YYYYMMDD-NNN
  StoreID      Int
  SupplierID   Int
  ImportDate   DateTime @default(now()) @db.Timestamp(0)
  TotalAmount  Decimal  @db.Decimal(18, 2)
  PaidAmount   Decimal  @db.Decimal(18, 2) @default(0) // Số tiền đã trả cho nhà cung cấp
  Status       String   @default("Pending") @db.VarChar(50)  // Trạng thái: Pending, Received
  Note         String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  supplier     Supplier @relation(fields: [SupplierID], references: [SupplierID], onDelete: Restrict)
  details      StockReceiptDetail[]
  linkedOrders Order[]  @relation("OrderLinkedReceipt")

  @@index([StoreID])
  @@index([SupplierID])
}

// 4. Chi tiết phiếu nhập
model StockReceiptDetail {
  DetailID     Int      @id @default(autoincrement())
  ReceiptID    Int
  ProductID    Int
  UnitName     String   @db.VarChar(50) // Đơn vị tính khi nhập (có thể khác BaseUnit)
  Quantity     Decimal  @db.Decimal(18, 2) // Số lượng nhập theo UnitName
  UnitPrice    Decimal  @db.Decimal(18, 2) // Giá nhập niêm yết của đơn vị này
  DiscountRate Decimal  @db.Decimal(5, 2) @default(0.00) // Chiết khấu từ NCC (0.10 = 10%)
  CostPrice    Decimal  @db.Decimal(18, 2) @default(0) // Giá vốn thực = UnitPrice × (1 - DiscountRate)
  ExchangeValue Decimal @db.Decimal(18, 3) @default(1) // Hệ số quy đổi về BaseUnit chốt tại thời điểm nhập

  // Relations
  receipt      StockReceipt @relation(fields: [ReceiptID], references: [ReceiptID], onDelete: Cascade)
  product      Product      @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)

  @@index([ReceiptID])
  @@index([ProductID])
}

// ==========================================
// BÁN HÀNG VÀ QUẢN LÝ ĐƠN HÀNG (SALES & ORDER MANAGEMENT) - GIAI ĐOẠN 9
// ==========================================

// 1. Quản lý Khách hàng
model Customer {
  CustomerID   Int      @id @default(autoincrement())
  CustomerCode String?  @unique @db.VarChar(20) // KH-YYYYMMDD-NNN
  StoreID      Int
  CustomerName String   @db.VarChar(255)
  Phone        String?  @db.VarChar(20)
  Address      String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt    DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  orders       Order[]

  @@index([StoreID])
}

// 2. Đơn hàng (Hóa đơn)
model Order {
  OrderID      Int      @id @default(autoincrement())
  OrderCode    String?  @unique @db.VarChar(30) // HD-YYYYMMDD-NNN
  StoreID      Int
  CustomerID   Int?     // Có thể bán cho khách vãng lai (null)
  UserID       Int      // Nhân viên thực hiện bán hàng
  OrderDate    DateTime @default(now()) @db.Timestamp(0)
  DeliveryMethod String @default("Immediate") @db.VarChar(50) // Tại quầy, Giao hàng, Nhận tại kho...
  LinkedReceiptID Int?  // FK trỏ tới StockReceipt nếu là giao thẳng
  TotalAmount  Decimal  @db.Decimal(18, 2)
  PaidAmount   Decimal  @db.Decimal(18, 2) @default(0) // Số tiền khách hàng đã trả
  Status       String   @default("Completed") @db.VarChar(50) // Completed, Pending, Cancelled
  Note         String?  @db.Text

  // Relations
  store          Store          @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  customer       Customer?      @relation(fields: [CustomerID], references: [CustomerID], onDelete: SetNull)
  user           User           @relation(fields: [UserID], references: [UserID], onDelete: Restrict)
  linkedReceipt  StockReceipt?  @relation("OrderLinkedReceipt", fields: [LinkedReceiptID], references: [ReceiptID], onDelete: SetNull)
  details        OrderDetail[]

  @@index([StoreID])
  @@index([CustomerID])
  @@index([UserID])
  @@index([LinkedReceiptID])
}

// 3. Chi tiết đơn hàng
model OrderDetail {
  DetailID     Int      @id @default(autoincrement())
  OrderID      Int
  ProductID    Int
  UnitName     String   @db.VarChar(50) // Đơn vị bán (Pallet, Thùng, Viên...)
  Quantity     Decimal  @db.Decimal(18, 2) // Số lượng bán theo UnitName
  UnitPrice    Decimal  @db.Decimal(18, 2) // Giá thực tế lúc chốt đơn
  CostPrice    Decimal  @db.Decimal(18, 2) @default(0) // Giá vốn tại thời điểm bán (để tính lợi nhuận)
  ExchangeValue Decimal @db.Decimal(18, 3) @default(1) // Hệ số quy đổi về BaseUnit chốt tại thời điểm bán
  
  // Relations
  order        Order    @relation(fields: [OrderID], references: [OrderID], onDelete: Cascade)
  product      Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)

  @@index([OrderID])
  @@index([ProductID])
}

// ==========================================
// BÁO CÁO VÀ CÔNG NỢ (REPORTING & DEBT MANAGEMENT) - GIAI ĐOẠN 10
// ==========================================

// Lịch sử biến động kho (Audit Log)
model InventoryLog {
  LogID          Int      @id @default(autoincrement())
  StoreID        Int
  ProductID      Int
  ChangeType     String   @db.VarChar(50) // IN (nhập), OUT (xuất/bán), ADJUST (điều chỉnh), RETURN (trả hàng)
  QuantityType   String   @db.VarChar(50) // Reserved, InTransit, Physical
  ReferenceType  String?  @db.VarChar(50) // Order, StockReceipt, DirectShip, Manual
  ReferenceID    Int?     // ID của Order hoặc StockReceipt
  OldQuantity    Decimal  @db.Decimal(18, 2)
  ChangeQuantity Decimal  @db.Decimal(18, 2) // Số dương = tăng, số âm = giảm
  NewQuantity    Decimal  @db.Decimal(18, 2)
  Note           String?  @db.Text
  CreatedBy      Int?     // UserID của người thực hiện
  CreatedAt      DateTime @default(now()) @db.Timestamp(0)

  // Relations
  product        Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)

  @@index([StoreID])
  @@index([ProductID])
  @@index([ReferenceType, ReferenceID])
  @@index([CreatedAt])
}